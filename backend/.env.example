ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# AI & Embeddings
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
HF_API_KEY=

# Database & Redis (use ?ssl=require / rediss:// in production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/luminote
RUN_DB_MIGRATIONS=true
DB_SSL_REQUIRE=false
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=replace-with-strong-64-char-secret-in-production
METRICS_TOKEN=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@luminote.com

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
